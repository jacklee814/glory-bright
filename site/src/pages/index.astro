---
import BaseLayout from '../layouts/BaseLayout.astro'; import ProductCard from '../components/ProductCard.astro'; import { products, categories, categoryPath } from '../lib/catalog'; const items=await products(); const cats=await categories();
---
<BaseLayout title="榮輝照明科技｜專業照明型錄"><section class="wrap" style="padding:5rem 0"><p class="mono">PROFESSIONAL LIGHTING CATALOG</p><h1 style="font-size:clamp(2.5rem,7vw,5.5rem);max-width:900px;margin:.25rem 0">先確定規格，再選擇光。</h1><p style="max-width:600px;font-size:1.1rem">為室內設計、工程與水電專業人員整理的照明型錄。依孔徑、色溫與型號快速找到合適產品。</p><a class="btn btn-accent" href="/products/">瀏覽產品</a></section><section class="wrap" style="padding:2rem 0"><h2>快速找燈</h2><form action="/products/" style="display:flex;gap:.5rem;flex-wrap:wrap"><select name="cutout"><option value="">埋入孔徑</option><option>60</option><option>75</option><option>90</option></select><select name="cct"><option value="">色溫</option><option>3000</option><option>4000</option><option>5700</option></select><button class="btn">開始查找</button></form></section><section class="wrap" style="padding:2rem 0"><h2>產品分類</h2><div class="grid">{cats.filter(c=>categoryPath(c.id).split('/').length===1).map(c=><a href={`/products/${categoryPath(c.id)}/`} style="background:white;border:1px solid var(--color-line);padding:2rem;text-decoration:none"><span class="mono">CATALOG</span><h3>{c.data.name}</h3><p>{c.data.description}</p></a>)}</div></section><section class="wrap" style="padding:2rem 0"><h2>熱門產品</h2><div class="grid">{items.slice(0,4).map(product=><ProductCard {product}/>)}</div></section><section class="wrap" style="padding:2rem 0"><h2>聯絡榮輝照明</h2><p style="font-size:2rem" class="mono"><a href="tel:0226328828">(02) 2632-8828</a></p><p><a href="mailto:glory.bright@msa.hinet.net">glory.bright@msa.hinet.net</a> · 地址待業主確認</p></section></BaseLayout>
