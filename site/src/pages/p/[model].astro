---
import { siteUrl } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro'; import ProductCard from '../../components/ProductCard.astro'; import CategorySidebar from '../../components/CategorySidebar.astro'; import { products, productUrl } from '../../lib/catalog'; import { modelSlug } from '@glory-bright/shared/slug';
export async function getStaticPaths(){const seen=new Set<string>();return (await products()).map(entry=>{const model=modelSlug(entry.data.model);if(seen.has(model))throw new Error(`型號 slug 重複：${model}`);seen.add(model);return {params:{model},props:{entry}}})}; const {entry}=Astro.props; const d=entry.data; /* glob loader 會把 index.json 的 id 收斂成 <分類路徑>/<型號slug>，故去掉最後一段即為所屬分類。 */ const categoryPath=entry.id.split('/').slice(0,-1).join('/'); const related=(await products()).filter(p=>p.id.split('/').slice(0,-1).join('/')===categoryPath&&p.id!==entry.id).slice(0,8);
---
<BaseLayout title={`${d.model} | 榮輝照明科技`}><div class="wrap" style="padding:2rem 0"><p><a href={siteUrl('/')}>首頁</a> › <a href={siteUrl('/products/')}>產品介紹</a> › {d.model}</p><div class="with-sidebar"><CategorySidebar current={categoryPath}/><div><div style="display:grid;gap:2rem;grid-template-columns:repeat(auto-fit,minmax(280px,1fr))"><section>{d.images.map((image,index)=><img src={siteUrl(image)} alt={index===0?`${d.model} 產品圖`:`${d.model} 規格圖 ${index}`} loading={index===0?undefined:'lazy'} style="width:100%;background:white;border:1px solid var(--color-line);margin-bottom:1rem"/>)}</section><section><p class="mono">{d.kind==='light'?'LIGHTING':'SWITCHES'}</p><h1 class="mono" style="font-size:2.4rem">{d.model}</h1>{d.kind==='light'&&d.name&&<p style="font-size:1.15rem;color:var(--color-muted);margin:-.25rem 0 1rem">{d.name}</p>}<dl style="display:grid;grid-template-columns:9rem 1fr;border-top:1px solid var(--color-line)">{d.kind==='light'?<><dt>功率</dt><dd>{d.watt?`${d.watt}W`:'—'}</dd><dt>色溫</dt><dd>{d.cct.length?d.cct.map(x=><span class="btn" style="padding:.2rem .5rem;margin:.15rem">{x}K</span>):'—'}</dd><dt>演色性</dt><dd>{d.cri?`CRI ${d.cri}`:'—'}</dd><dt>孔徑</dt><dd>{d.cutoutDia?`${d.cutoutDia}mm`:'—'}</dd><dt>角度</dt><dd>{d.beamAngle.length?`${d.beamAngle.join('° / ')}°`:'—'}</dd><dt>燈座</dt><dd>{d.socket??'—'}</dd><dt>顏色</dt><dd>{d.colors.join('、')||'—'}</dd><dt>尺寸</dt><dd>{d.dimensions??'—'}</dd><dt>電壓</dt><dd>{d.voltage??'—'}</dd>{Object.entries(d.extras).map(([label,value])=><><dt>{label}</dt><dd>{value}</dd></>)}</>:<><dt>系列</dt><dd>{d.series.toUpperCase()}</dd><dt>類型</dt><dd>{({switch:'開關',socket:'插座',panel:'面板'})[d.type]}</dd><dt>說明</dt><dd>{d.description.length?<ul style="margin:0;padding-left:1.2rem">{d.description.map(line=><li>{line}</li>)}</ul>:'—'}</dd></>} </dl>{d.kind==='light'&&d.notes.length>0&&<ul style="margin:1rem 0 0;padding-left:1.2rem;color:var(--color-muted)">{d.notes.map(note=><li>{note}</li>)}</ul>}</section></div>{related.length>0&&<section style="margin-top:3rem"><h2>同類產品</h2><div class="grid">{related.map(product=><ProductCard {product}/>)}</div></section>}</div></div></div></BaseLayout>
