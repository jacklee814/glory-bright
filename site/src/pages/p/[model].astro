---
import { siteUrl } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro'; import ProductCard from '../../components/ProductCard.astro'; import { products, productUrl } from '../../lib/catalog'; import { modelSlug } from '@glory-bright/shared/slug';
export async function getStaticPaths(){const seen=new Set<string>();return (await products()).map(entry=>{const model=modelSlug(entry.data.model);if(seen.has(model))throw new Error(`型號 slug 重複：${model}`);seen.add(model);return {params:{model},props:{entry}}})}; const {entry}=Astro.props; const d=entry.data; const related=(await products()).filter(p=>p.id.split('/').slice(0,-2).join('/')===entry.id.split('/').slice(0,-2).join('/')&&p.id!==entry.id).slice(0,8);
---
<BaseLayout title={`${d.model} | 榮輝照明科技`}><div class="wrap" style="padding:2rem 0"><p><a href={siteUrl('/products/')}>產品介紹</a> › {d.kind==='light'?'燈具':'開關面板'}</p><div style="display:grid;gap:2rem;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))"><section><img src={siteUrl(d.images[0])} alt={`${d.model} 產品圖`} width="600" height="600" style="width:100%;background:white;border:1px solid var(--color-line)"/></section><section><p class="mono">{d.kind==='light'?'LIGHTING':'SWITCHES'}</p><h1 class="mono" style="font-size:2.4rem">{d.model}</h1><dl style="display:grid;grid-template-columns:9rem 1fr;border-top:1px solid var(--color-line)">{d.kind==='light'?<><dt>功率</dt><dd>{d.watt?`${d.watt}W`:'—'}</dd><dt>色溫</dt><dd>{d.cct.length?d.cct.map(x=><span class="btn" style="padding:.2rem .5rem;margin:.15rem">{x}K</span>):'—'}</dd><dt>演色性</dt><dd>{d.cri?`CRI ${d.cri}`:'—'}</dd><dt>孔徑</dt><dd>{d.cutoutDia?`${d.cutoutDia}mm`:'—'}</dd><dt>角度</dt><dd>{d.beamAngle.length?`${d.beamAngle.join('° / ')}°`:'—'}</dd><dt>燈座</dt><dd>{d.socket??'—'}</dd><dt>顏色</dt><dd>{d.colors.join('、')||'—'}</dd><dt>尺寸</dt><dd>{d.dimensions??'—'}</dd><dt>電壓</dt><dd>{d.voltage??'—'}</dd></>:<><dt>系列</dt><dd>{d.series.toUpperCase()}</dd><dt>類型</dt><dd>{({switch:'開關',socket:'插座',panel:'面板'})[d.type]}</dd><dt>說明</dt><dd>{d.description.length?<ul style="margin:0;padding-left:1.2rem">{d.description.map(line=><li>{line}</li>)}</ul>:'—'}</dd></>} </dl><p style="display:flex;gap:.5rem;flex-wrap:wrap"><a class="btn btn-accent" href="tel:0226328828">電話詢價</a><a class="btn" href={`mailto:glory.bright@msa.hinet.net?subject=${encodeURIComponent(`詢價：${d.model}`)}`}>E-mail 詢價</a></p></section></div>{related.length>0&&<section style="margin-top:4rem"><h2>同類產品</h2><div class="grid">{related.map(product=><ProductCard {product}/>)}</div></section>}</div></BaseLayout>
