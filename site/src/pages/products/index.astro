---
import BaseLayout from '../../layouts/BaseLayout.astro'; import ProductCard from '../../components/ProductCard.astro'; import { products } from '../../lib/catalog'; const all=await products();
---
<BaseLayout title="產品介紹 | 榮輝照明科技"><div class="wrap" style="padding:2rem 0"><p><a href="/">首頁</a> › 產品介紹</p><h1>產品介紹</h1><form id="filters" style="display:flex;gap:.5rem;flex-wrap:wrap;margin:1rem 0"><input id="model-search" placeholder="搜尋型號，例如 2060"/><select id="cutout"><option value="">全部孔徑</option><option value="60">孔徑 60mm</option></select><select id="cct"><option value="">全部色溫</option><option value="3000">3000K</option><option value="4000">4000K</option></select></form><p id="result-count" class="mono">共 {all.length} 項</p><div class="grid" id="product-grid">{all.map(product=><div data-model={product.data.model.toLowerCase()} data-cutout={product.data.kind==='light'?product.data.cutoutDia:''} data-cct={product.data.kind==='light'?product.data.cct.join(','):''}><ProductCard {product}/></div>)}</div><script is:inline>const params=new URLSearchParams(location.search);const search=document.querySelector('#model-search');const cutout=document.querySelector('#cutout');const cct=document.querySelector('#cct');const cards=[...document.querySelectorAll('#product-grid>div')];const count=document.querySelector('#result-count');search.value=params.get('q')||'';cutout.value=params.get('cutout')||'';cct.value=params.get('cct')||'';function filter(){let total=0;cards.forEach(card=>{const visible=card.dataset.model.includes(search.value.toLowerCase())&&(!cutout.value||card.dataset.cutout===cutout.value)&&(!cct.value||card.dataset.cct.includes(cct.value));card.hidden=!visible;if(visible)total++});count.textContent=`共 ${total} 項`;const next=new URLSearchParams();if(search.value)next.set('q',search.value);if(cutout.value)next.set('cutout',cutout.value);if(cct.value)next.set('cct',cct.value);history.replaceState({},'',`${location.pathname}?${next}`)}[search,cutout,cct].forEach(control=>control.addEventListener('input',filter));filter();</script></div></BaseLayout>
