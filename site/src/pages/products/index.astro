---
import BaseLayout from '../../layouts/BaseLayout.astro'; import ProductCard from '../../components/ProductCard.astro'; import { products } from '../../lib/catalog'; const all=await products();
---
<BaseLayout title="產品介紹 | 榮輝照明科技"><div class="wrap" style="padding:2rem 0"><p><a href="/">首頁</a> › 產品介紹</p><h1>產品介紹</h1><form id="filters" style="display:flex;gap:.5rem;flex-wrap:wrap;margin:1rem 0"><input id="model-search" placeholder="搜尋型號，例如 2060"/><select id="cutout"><option value="">全部孔徑</option><option value="60">孔徑 60mm</option></select><select id="cct"><option value="">全部色溫</option><option value="3000">3000K</option><option value="4000">4000K</option></select></form><p id="result-count" class="mono">共 {all.length} 項</p><div class="grid" id="product-grid">{all.map(product=><div data-model={product.data.model.toLowerCase()} data-cutout={product.data.kind==='light'?product.data.cutoutDia:''} data-cct={product.data.kind==='light'?product.data.cct.join(','):''}><ProductCard {product}/></div>)}</div><script is:inline>{`const q=new URLSearchParams(location.search);const s=document.querySelector('#model-search'),cut=document.querySelector('#cutout'),cct=document.querySelector('#cct'),cards=[...document.querySelectorAll('#product-grid>div')],count=document.querySelector('#result-count');s.value=q.get('q')||'';cut.value=q.get('cutout')||'';cct.value=q.get('cct')||'';function f(){let n=0;cards.forEach(x=>{const ok=x.dataset.model.includes(s.value.toLowerCase())&&(!cut.value||x.dataset.cutout===cut.value)&&(!cct.value||x.dataset.cct.includes(cct.value));x.hidden=!ok;if(ok)n++});count.textContent='共 '+n+' 項';history.replaceState({},'',location.pathname+'?'+new URLSearchParams({q:s.value,cutout:cut.value,cct:cct.value}))} [s,cut,cct].forEach(x=>x.addEventListener('input',f));f()`}</script></div></BaseLayout>
