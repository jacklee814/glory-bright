---
import ProductCard from './ProductCard.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { items: CollectionEntry<'products'>[] }
const { items } = Astro.props;
const groups: [string,string,string[][]][] = [
  ['cutout','埋入孔徑',['60','75','90','100','125'].map(x=>[x,`${x}mm`])],
  ['type','燈具類型',[['downlight','崁燈'],['track','軌道燈'],['ceiling-pendant','吸頂／懸吊'],['linear','線型燈'],['office','辦公／工程']]],
  ['cct','色溫',['2700','3000','4000','5700'].map(x=>[x,`${x}K`])],
  ['watt','功率',[['under10','小於 10W'],['10to20','10–20W（不含 20）'],['20to30','20–30W（不含 30）'],['30plus','30W 以上']]],
  ['cri','演色性',[['80','CRI 80'],['90','CRI 90+']]],
  ['beam','角度',['15','24','36','60'].map(x=>[x,`${x}°`])],
  ['color','燈具顏色',[['白','白'],['黑','黑'],['其他','其他']]],
  ['series','開關系列',[['unica','UNICA'],['zencelo','ZENcelo']]],
  ['switchType','開關類型',[['switch','開關'],['socket','插座'],['eu-panel','面板']]],
  ['finish','面板顏色',[...new Set(items.flatMap(p=>p.data.kind==='switch'?p.data.finish:[]))].map(x=>[x,x])],
  ['gang','連數',[...new Set(items.flatMap(p=>p.data.kind==='switch'&&p.data.gang?[String(p.data.gang)]:[]))].sort().map(x=>[x,`${x}連`])],
];
---
<div class="catalog">
  <details class="filter-panel" open>
    <summary>篩選產品</summary>
    <form id="catalog-filters">
      <label for="model-search">搜尋型號</label>
      <input id="model-search" name="q" type="search" placeholder="例如 GB-DMR 或 2060" />
      {groups.filter(([, , options])=>options.length).map(([key,label,options])=><fieldset><legend>{label}</legend>{options.map(([value,text])=><label><input type="checkbox" name={key} value={value}/>{text}</label>)}</fieldset>)}
      <button type="reset" class="btn">清除全部條件</button>
    </form>
  </details>
  <section aria-label="產品搜尋結果">
    <p id="result-count" role="status">共 {items.length} 項</p>
    <div id="filter-chips" aria-label="已選條件"></div>
    <p id="empty-results" hidden>沒有符合條件的產品，請移除部分條件或改用型號搜尋。</p>
    <ul class="grid" id="product-grid">
      {items.map(product=><li data-product={JSON.stringify({ ...product.data, path:product.id.split('/') })}><ProductCard {product}/></li>)}
    </ul>
  </section>
</div>
<script>import '../scripts/filter';</script>
<style>
  .catalog { display:grid; grid-template-columns:240px minmax(0,1fr); gap:32px; }
  .filter-panel { border:1px solid var(--color-line); padding:16px; align-self:start; background:white; }
  summary { font-weight:700; cursor:pointer; margin-bottom:16px; }
  input[type=search] { width:100%; padding:8px; border:1px solid var(--color-line); }
  fieldset { margin-top:16px; padding-top:8px; border:0; border-top:1px solid var(--color-line); }
  legend { font-weight:700; }
  fieldset label { display:flex; align-items:center; gap:8px; padding:4px 0; }
  ul { list-style:none; padding:0; }
  #filter-chips { display:flex; flex-wrap:wrap; gap:8px; margin:16px 0; }
  :global(.filter-chip) { padding:8px; border:1px solid var(--color-line); background:#fff3d8; }
  @media(max-width:767px) { .catalog { grid-template-columns:1fr; } }
</style>
