---
import { siteUrl } from '../lib/url';

/** 與 tools/scraper/src/hero.ts 的 HERO_IMAGES 對應，由 emit 轉成 WebP 輸出到 /hero/。 */
const slides = [
  { slug: 'unica-living',   alt: 'Unica 全彩智能開關情境照：綠色牆面客廳中的雙切開關面板' },
  { slug: 'zencelo-lounge', alt: 'ZENcelo 點藏純平開關情境照：木質牆面休閒椅旁的純平開關面板' },
  { slug: 'unica-top',      alt: 'Unica Top 系列面板材質一覽：原木、金屬與多聯大型面板型號對照' },
  { slug: 'unica-plus',     alt: 'Unica Plus 系列面板材質一覽：塑膠材質與多聯大型面板型號對照' },
];
---
<section class="hero" aria-label="產品情境輪播" aria-roledescription="carousel">
  <ul class="track">
    {slides.map((slide, index) => (
      <li aria-label={`第 ${index + 1} 張，共 ${slides.length} 張`} aria-roledescription="slide">
        <img src={siteUrl(`/hero/${slide.slug}.webp`)} alt={slide.alt} width="940" height="400" loading={index === 0 ? 'eager' : 'lazy'}/>
      </li>
    ))}
  </ul>
</section>
<script>
  /*
   * 自動輪播，不提供可見的切換控制項。
   *
   * 自動移動的內容需要可暫停的機制（WCAG 2.2.2）。在沒有按鈕的前提下，這裡以
   * 滑鼠移入／鍵盤聚焦暫停、分頁隱藏時停止、並在使用者開啟「減少動態效果」時
   * 完全不自動輪播來降低影響；觸控與捲動仍可手動切換。
   * 沒有 JavaScript 時會停在第一張，仍是有效的首頁視覺。
   */
  const INTERVAL_MS = 5000;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  for (const track of document.querySelectorAll<HTMLElement>('.hero .track')) {
    const count = track.children.length;
    if (count < 2) continue;

    let timer: number | undefined;
    let paused = false;

    const advance = () => {
      const width = track.clientWidth;
      if (width === 0) return;
      const next = (Math.round(track.scrollLeft / width) + 1) % count;
      track.scrollTo({ left: next * width, behavior: 'smooth' });
    };
    const stop = () => { if (timer !== undefined) { clearInterval(timer); timer = undefined; } };
    const start = () => {
      if (timer === undefined && !paused && !reduceMotion.matches && !document.hidden) {
        timer = setInterval(advance, INTERVAL_MS);
      }
    };
    const pause = () => { paused = true; stop(); };
    const resume = () => { paused = false; start(); };

    track.addEventListener('pointerenter', pause);
    track.addEventListener('pointerleave', resume);
    track.addEventListener('focusin', pause);
    track.addEventListener('focusout', resume);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    reduceMotion.addEventListener('change', () => (reduceMotion.matches ? stop() : start()));

    start();
  }
</script>
<style>
  .hero { margin:0 0 2rem; }
  .track {
    display:flex; list-style:none; margin:0; padding:0; gap:0;
    overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth;
    border:1px solid var(--color-line); background:var(--color-surface);
    /* 沒有可見控制項，隱藏捲軸讓版面乾淨；觸控仍可滑動。 */
    scrollbar-width:none;
  }
  .track::-webkit-scrollbar { display:none; }
  .track li { flex:0 0 100%; scroll-snap-align:center; }
  .track img { display:block; width:100%; height:auto; }
  /* 尊重使用者的減少動態偏好：不平滑捲動，腳本也不會自動輪播。 */
  @media (prefers-reduced-motion: reduce) { .track { scroll-behavior:auto; } }
</style>
