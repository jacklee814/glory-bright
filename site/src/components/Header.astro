---
import { categories, categoryPath } from '../lib/catalog'; const cats=await categories();
---
<header style="background:white;border-bottom:1px solid var(--color-line)"><div class="wrap" style="display:flex;gap:1rem;align-items:center;padding:1rem 0;flex-wrap:wrap"><a href="/" class="mono" style="font-weight:700;text-decoration:none;font-size:1.2rem">GLORY BRIGHT</a><nav style="display:flex;gap:1rem;margin-left:auto"><a href="/">首頁</a><a href="/products/">產品介紹</a><a href="/news/">最新消息</a></nav><form action="/products/" style="display:flex"><label><span class="sr-only">搜尋型號</span><input name="q" placeholder="搜尋型號" style="padding:.45rem;border:1px solid var(--color-line);max-width:9rem"/></label></form></div><div class="wrap" style="padding:0 0 .75rem;display:flex;gap:1rem;overflow:auto">{cats.filter(c=>categoryPath(c.id).split('/').length===1).map(c=><a href={`/products/${categoryPath(c.id)}/`}>{c.data.name}</a>)}</div></header>
