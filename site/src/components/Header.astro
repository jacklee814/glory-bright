---
import { siteUrl } from '../lib/url';
import { categories, categoryPath } from '../lib/catalog';
const cats=await categories();
---
<header>
  <div class="wrap header-row">
    <a href={siteUrl('/')} class="mono brand">GLORY BRIGHT LIGHTING<span>榮輝照明科技</span></a>
    <nav class="desktop-nav" aria-label="主要導覽">
      <a href={siteUrl('/')}>首頁</a>
      <a href={siteUrl('/products/')}>產品介紹</a>
    </nav>
    <button type="button" id="menu-open" class="btn mobile-menu-button" aria-label="開啟導覽">選單</button>
  </div>
</header>
<dialog id="mobile-menu" aria-label="網站導覽">
  <form method="dialog"><button class="btn">關閉選單</button></form>
  <nav aria-label="手機導覽"><a href={siteUrl('/')}>首頁</a><a href={siteUrl('/products/')}>全部產品</a>{cats.map(c=><a style={`padding-left:${(categoryPath(c.id).split('/').length-1)*16}px`} href={siteUrl(`/products/${categoryPath(c.id)}/`)}>{c.data.name}</a>)}</nav>
</dialog>
<script>
  const menu=document.querySelector<HTMLDialogElement>('#mobile-menu')!;
  document.querySelector('#menu-open')!.addEventListener('click',()=>menu.showModal());
</script>
<style>
header{background:white;border-bottom:1px solid var(--color-line);position:relative;z-index:5}.header-row{display:flex;gap:24px;align-items:center;padding:24px 0}.brand{font-weight:700;font-size:20px;text-decoration:none}.brand span{display:block;font-size:12px;letter-spacing:2px}.desktop-nav{display:flex;gap:24px;margin-left:auto}.desktop-nav a{text-decoration:none}.mobile-menu-button{display:none}#mobile-menu{position:fixed;inset:0;width:100%;max-width:none;height:100%;max-height:none;margin:0;padding:24px;border:0}#mobile-menu nav{display:grid;gap:16px;margin-top:24px}@media(max-width:767px){.header-row{flex-wrap:wrap;gap:16px}.desktop-nav{display:none}.mobile-menu-button{display:block;margin-left:auto}}
</style>
