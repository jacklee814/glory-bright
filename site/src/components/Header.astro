---
import { siteUrl } from '../lib/url';
import { categories, categoryPath, products, productUrl } from '../lib/catalog';
const cats=await categories();
const models=(await products()).map(p=>({model:p.data.model,url:productUrl(p.data.model)}));
---
<header>
  <div class="wrap header-row">
    <a href={siteUrl('/')} class="mono brand">GLORY BRIGHT<span>榮輝照明科技</span></a>
    <nav class="desktop-nav" aria-label="主要導覽">
      <a href={siteUrl('/')}>首頁</a>
      <div class="catalog-menu"><a href={siteUrl('/products/')}>產品介紹</a><div class="mega-menu"><a href={siteUrl('/products/')}>全部產品 →</a>{cats.map(c=><a style={`padding-left:${(categoryPath(c.id).split('/').length-1)*16}px`} href={siteUrl(`/products/${categoryPath(c.id)}/`)}>{c.data.name}</a>)}</div></div>
    </nav>
    <form action={siteUrl('/products/')} class="header-search" role="search">
      <label for="header-search">搜尋型號</label>
      <input id="header-search" name="q" placeholder="輸入型號" autocomplete="off" aria-controls="search-results"/>
      <ul id="search-results" hidden aria-label="型號搜尋結果"></ul>
    </form>
    <button type="button" id="menu-open" class="btn mobile-menu-button" aria-label="開啟導覽">選單</button>
  </div>
</header>
<dialog id="mobile-menu" aria-label="網站導覽">
  <form method="dialog"><button class="btn">關閉選單</button></form>
  <nav aria-label="手機導覽"><a href={siteUrl('/')}>首頁</a><a href={siteUrl('/products/')}>全部產品</a>{cats.map(c=><a style={`padding-left:${(categoryPath(c.id).split('/').length-1)*16}px`} href={siteUrl(`/products/${categoryPath(c.id)}/`)}>{c.data.name}</a>)}</nav>
</dialog>
<script id="search-models" type="application/json" set:html={JSON.stringify(models).replace(/</g,'\\u003c')}/>
<script>
  const menu=document.querySelector<HTMLDialogElement>('#mobile-menu')!;
  document.querySelector('#menu-open')!.addEventListener('click',()=>menu.showModal());
  const input=document.querySelector<HTMLInputElement>('#header-search')!;
  const results=document.querySelector<HTMLElement>('#search-results')!;
  const models: {model:string;url:string}[]=JSON.parse(document.querySelector('#search-models')!.textContent!);
  input.addEventListener('input',()=>{
    results.replaceChildren();
    const query=input.value.trim().toLowerCase();
    results.hidden=!query;
    if(!query)return;
    const matches=models.filter(item=>item.model.toLowerCase().includes(query)).slice(0,8);
    for(const item of matches){const li=document.createElement('li');const a=document.createElement('a');a.href=item.url;a.textContent=item.model;li.append(a);results.append(li);}
    if(!matches.length){const li=document.createElement('li');li.textContent='沒有符合的型號';results.append(li);}
  });
  input.addEventListener('keydown',event=>{if(event.key==='Escape')results.hidden=true;});
  document.addEventListener('click',event=>{if(event.target instanceof Node&&!input.closest('form')!.contains(event.target))results.hidden=true;});
</script>
<style>
header{background:white;border-bottom:1px solid var(--color-line);position:relative;z-index:5}.header-row{display:flex;gap:24px;align-items:center;padding:24px 0}.brand{font-weight:700;font-size:20px;text-decoration:none}.brand span{display:block;font-size:12px;letter-spacing:2px}.desktop-nav{display:flex;gap:24px;margin-left:auto}.desktop-nav a{text-decoration:none}.header-search{position:relative}.header-search label{display:block;font-size:12px}.header-search input{width:180px;padding:8px;border:1px solid var(--color-line)}#search-results{position:absolute;right:0;top:100%;background:white;width:260px;list-style:none;box-shadow:0 4px 12px #0002;padding:8px}#search-results :global(a){display:block;padding:12px}.mega-menu{display:none;position:absolute;top:100%;left:0;right:0;background:white;border-bottom:1px solid var(--color-line);padding:24px;grid-template-columns:repeat(4,1fr);gap:16px}.catalog-menu{padding:24px 0;margin:-24px 0}.catalog-menu:hover .mega-menu,.catalog-menu:focus-within .mega-menu{display:grid}.mobile-menu-button{display:none}#mobile-menu{position:fixed;inset:0;width:100%;max-width:none;height:100%;max-height:none;margin:0;padding:24px;border:0}#mobile-menu nav{display:grid;gap:16px;margin-top:24px}@media(max-width:767px){.header-row{flex-wrap:wrap;gap:16px}.desktop-nav{display:none}.mobile-menu-button{display:block;margin-left:auto}.header-search{order:3;width:100%}.header-search input{width:100%}#search-results{width:100%}}
</style>
