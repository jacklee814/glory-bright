---
import { products } from '../lib/catalog';
const rows = (await products()).map(p => p.data);
---
<section id="compare-bar" hidden aria-label="已選比較產品">
  <span id="compare-summary" aria-live="polite"></span>
  <button class="btn" id="compare-open" type="button">查看規格比較</button>
  <button class="btn" id="compare-clear" type="button">清空</button>
</section>
<p id="compare-status" class="sr-only" role="status"></p>
<dialog id="compare-dialog" aria-labelledby="compare-title">
  <h2 id="compare-title">產品規格比較</h2>
  <p>琥珀底色表示規格不同；「—」表示未提供或不適用。</p>
  <form method="dialog"><button class="btn">關閉比較</button></form>
  <div class="compare-scroll"><table id="compare-table"></table></div>
</dialog>
<script id="compare-data" type="application/json" set:html={JSON.stringify(rows).replace(/</g, '\\u003c')} />
<script>
  import '../scripts/compare';
</script>
<style>
  #compare-bar:not([hidden]) { position:fixed; bottom:0; inset-inline:0; z-index:20; display:flex; gap:16px; align-items:center; justify-content:center; flex-wrap:wrap; padding:16px; background:white; border-top:2px solid var(--color-accent); }
  dialog { width:min(1000px,95vw); max-height:85vh; padding:24px; border:1px solid var(--color-line); }
  dialog::backdrop { background:#0008; }
  .compare-scroll { overflow:auto; margin-top:24px; }
  :global(#compare-table) { width:100%; border-collapse:collapse; }
  :global(#compare-table th), :global(#compare-table td) { padding:16px; border:1px solid var(--color-line); text-align:left; min-width:140px; }
  :global(#compare-table .different) { background:#fff3d8; }
  @media(max-width:767px) { #compare-bar:not([hidden]) { bottom:56px; padding:8px; gap:8px; } }
</style>
